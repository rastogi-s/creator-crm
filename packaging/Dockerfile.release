# Image used by the release workflow: packages the already-built and tested jar (no build inside).
# Build context is packaging/ with creator-crm.jar copied into it.
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 crm && mkdir /data && chown crm /data
COPY creator-crm.jar /app/app.jar
USER crm
ENV CRM_DATA_DIR=/data \
    HOST=0.0.0.0 \
    PORT=8080
EXPOSE 8080
VOLUME /data
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
