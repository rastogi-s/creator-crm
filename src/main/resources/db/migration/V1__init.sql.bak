-- Works on PostgreSQL and on H2 (MODE=PostgreSQL) for the local profile.

CREATE TABLE brands (
    id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name          VARCHAR(200) NOT NULL,
    name_key      VARCHAR(200) NOT NULL UNIQUE,
    website       VARCHAR(500),
    contact_name  VARCHAR(200),
    contact_email VARCHAR(320),
    instagram     VARCHAR(100),
    notes         VARCHAR,
    created_at    TIMESTAMP WITH TIME ZONE NOT NULL
);

CREATE TABLE conversations (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    brand_id        BIGINT REFERENCES brands (id),
    platform        VARCHAR(20) NOT NULL,
    external_id     VARCHAR(200) NOT NULL,
    subject         VARCHAR(1000),
    counterparty    VARCHAR(320),       -- email address or Instagram-scoped user id of the other party
    summary         VARCHAR,            -- rolling AI summary, so we never resend whole threads
    brand_related   BOOLEAN,
    created_at      TIMESTAMP WITH TIME ZONE NOT NULL,
    last_message_at TIMESTAMP WITH TIME ZONE,
    CONSTRAINT uq_conversation UNIQUE (platform, external_id)
);

CREATE TABLE messages (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    conversation_id BIGINT NOT NULL REFERENCES conversations (id),
    external_id     VARCHAR(200) NOT NULL UNIQUE,
    direction       VARCHAR(10) NOT NULL,   -- INBOUND | OUTBOUND
    sender          VARCHAR(320),
    sender_name     VARCHAR(200),
    recipient       VARCHAR(1000),
    subject         VARCHAR(1000),
    content         VARCHAR,
    rfc_message_id  VARCHAR(500),
    reply_to        VARCHAR(320),
    sent_at         TIMESTAMP WITH TIME ZONE NOT NULL,
    message_type    VARCHAR(40),            -- AI intent, e.g. CONTRACT_SENT
    ai_processed    BOOLEAN NOT NULL DEFAULT FALSE,
    filtered_reason VARCHAR(200)            -- why the pre-filter skipped it, if it did
);
CREATE INDEX ix_messages_conversation ON messages (conversation_id);

CREATE TABLE opportunities (
    id               BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    brand_id         BIGINT NOT NULL REFERENCES brands (id),
    conversation_id  BIGINT REFERENCES conversations (id),
    origin           VARCHAR(20) NOT NULL,   -- INBOUND | PITCH
    type             VARCHAR(40) NOT NULL,
    compensation     VARCHAR(20) NOT NULL,
    status           VARCHAR(40) NOT NULL,
    budget_amount    NUMERIC(12, 2),
    currency         VARCHAR(10),
    budget_text      VARCHAR(500),
    deliverables     VARCHAR(2000),
    usage_rights     VARCHAR(1000),
    campaign         VARCHAR(500),
    missing_info     VARCHAR(2000),
    next_step        VARCHAR(1000),
    pitch_platform   VARCHAR(40),
    pitched_at       DATE,
    initial_response VARCHAR(2000),
    closed_reason    VARCHAR(200),
    created_at       TIMESTAMP WITH TIME ZONE NOT NULL,
    updated_at       TIMESTAMP WITH TIME ZONE NOT NULL
);
CREATE INDEX ix_opportunities_status ON opportunities (status);

CREATE TABLE tasks (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    opportunity_id  BIGINT REFERENCES opportunities (id),
    type            VARCHAR(40) NOT NULL,
    description     VARCHAR(1000) NOT NULL,
    priority        VARCHAR(10) NOT NULL,
    due_date        DATE,
    status          VARCHAR(20) NOT NULL,
    followup_number INTEGER,
    source_message_id BIGINT REFERENCES messages (id),
    created_at      TIMESTAMP WITH TIME ZONE NOT NULL,
    completed_at    TIMESTAMP WITH TIME ZONE
);
CREATE INDEX ix_tasks_status ON tasks (status);

CREATE TABLE followups (
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    opportunity_id BIGINT NOT NULL REFERENCES opportunities (id),
    number         INTEGER NOT NULL,
    scheduled_date DATE NOT NULL,
    completed_date DATE,
    status         VARCHAR(20) NOT NULL      -- SCHEDULED | DONE | CANCELLED
);
CREATE INDEX ix_followups_status ON followups (status, scheduled_date);

CREATE TABLE deadlines (
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    opportunity_id BIGINT NOT NULL REFERENCES opportunities (id),
    type           VARCHAR(30) NOT NULL,
    due_date       DATE NOT NULL,
    description    VARCHAR(1000),
    done           BOOLEAN NOT NULL DEFAULT FALSE,
    CONSTRAINT uq_deadline UNIQUE (opportunity_id, type, due_date)
);

CREATE TABLE drafts (
    id              BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    opportunity_id  BIGINT NOT NULL REFERENCES opportunities (id),
    conversation_id BIGINT REFERENCES conversations (id),
    task_id         BIGINT REFERENCES tasks (id),
    followup_id     BIGINT REFERENCES followups (id),
    channel         VARCHAR(20) NOT NULL,   -- EMAIL | INSTAGRAM
    type            VARCHAR(40) NOT NULL,
    to_address      VARCHAR(320),
    subject         VARCHAR(1000),
    body            VARCHAR NOT NULL,
    in_reply_to     VARCHAR(500),
    gmail_thread_id VARCHAR(200),
    gmail_draft_id  VARCHAR(200),
    status          VARCHAR(20) NOT NULL,     -- PENDING | SENT | DISCARDED | SUPERSEDED | FAILED
    error           VARCHAR(2000),
    created_at      TIMESTAMP WITH TIME ZONE NOT NULL,
    sent_at         TIMESTAMP WITH TIME ZONE
);

CREATE TABLE activity (
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    opportunity_id BIGINT REFERENCES opportunities (id),
    type           VARCHAR(40) NOT NULL,
    text           VARCHAR(2000) NOT NULL,
    at             TIMESTAMP WITH TIME ZONE NOT NULL
);
CREATE INDEX ix_activity_at ON activity (at);

CREATE TABLE app_state (
    state_key   VARCHAR(100) PRIMARY KEY,
    state_value VARCHAR(2000) NOT NULL
);

-- ---------- security & settings ----------

CREATE TABLE users (
    id            BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username      VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(200) NOT NULL,
    created_at    TIMESTAMP WITH TIME ZONE NOT NULL
);

-- Credentials entered in the setup wizard. value_enc is AES-256-GCM ciphertext; never plaintext.
CREATE TABLE secrets (
    name       VARCHAR(100) PRIMARY KEY,
    value_enc  VARCHAR(8000) NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL
);

-- Non-secret preferences (creator name, voice/rates profile, cadence, models...).
CREATE TABLE settings (
    name       VARCHAR(100) PRIMARY KEY,
    value      VARCHAR NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL
);
